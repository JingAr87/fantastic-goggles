# SPDX-License-Identifier: GPL-2.0-only
#
# ZTE ZXHN F6600P (ZX279128S + MT7916AN AX3000) image build definition
# for target/linux/sanechips/image/Makefile.

define Build/f6600p-factory
	python3 $(TOPDIR)/tools/pack_f6600p.py pack \
		--slot 0 \
		--kernel $(IMAGE_KERNEL) \
		--rootfs $(IMAGE_ROOTFS) \
		--mkfs-jffs2 $(STAGING_DIR_HOST)/bin/mkfs.jffs2 \
		--out $@
endef

define Device/zte_zxhn-f6600p
  DEVICE_VENDOR := ZTE
  DEVICE_MODEL := ZXHN F6600P
  DEVICE_VARIANT := V9.1
  DEVICE_DTS := zx279128s-zte-f6600p
  DEVICE_DTS_DIR := $(TOPDIR)/target/linux/sanechips/dts
  KERNEL_SIZE := 5120k
  KERNEL_INITRAMFS := kernel-bin | append-dtb | uImage-ramboot
  KERNEL := kernel-bin | append-dtb | uImage none
  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7916-firmware \
	kmod-nft-offload ubi-utils block-mount \
	kmod-usb3 kmod-usb-dwc3 kmod-usb-storage kmod-usb-ledtrig-usbport \
	kmod-fs-ext4 kmod-fs-vfat kmod-nls-cp437 kmod-nls-iso8859-1 kmod-nls-utf8 \
	usbutils \
	libustream-mbedtls \
	luci luci-proto-ppp luci-app-ttyd ttyd \
	luci-theme-bootstrap
  IMAGES := factory.bin sysupgrade.bin
  IMAGE/factory.bin := f6600p-factory
  IMAGE/sysupgrade.bin := f6600p-factory | append-metadata
endef
TARGET_DEVICES += zte_zxhn-f6600p
